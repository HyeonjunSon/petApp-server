# ── Offleash API environment ─────────────────────────────────
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/offleash
JWT_SECRET=change-me

# comma-separated allowed origins (wildcards like https://*.vercel.app ok)
CORS_ORIGINS=http://localhost:3000

# photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# email verification codes
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# optional — PostgreSQL analytics (docker-compose.postgres.yml)
# DATABASE_URL=postgresql://petdate:petdate@localhost:5433/petdate_analytics

# optional — future Stripe wiring (billing runs in demo mode without it)
# STRIPE_SECRET_KEY=
